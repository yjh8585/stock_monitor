# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
# 이 프로젝트는 npm 전용(package-lock.json) — 글로벌 pnpm 설정이 만든 stray 락파일 무시(format:check 깨짐 방지)
pnpm-lock.yaml

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# MCP
mcp-shrimp-task-manager/node_modules/
.shrimp_data/

# Python
scripts/venv/
scripts/__pycache__/
scripts/**/__pycache__/
*.pyc

# 일회성 디버그/분석 산출물 (재발 방지)
scripts/docs_cache/
scripts/logs/
scripts/debug_*.png
docs_cache/

# 브라우저 자동화: Marklines 봇 산출물 (사용자 Chrome 프로파일은 OS 영역이라 별도 ignore 불필요)
scripts/_marklines_state.json
scripts/_debug_bosch_body.txt
scripts/_marklines_direct_log.json

# MCP 로컬 설정 (토큰 포함 — 커밋 금지)
.mcp.json

# env
.env.local
.env*.local

# Claude Code 로컬 상태 (사용자 권한 설정 / 스케줄 lock / 개인 hookify 규칙)
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/hookify.*.local.md

# 로그 / 임시 디렉토리
*.log
dev.log
tmp/
supabase/.temp/

# 사용자 참고 자료 (PDF/외부 문서)
참고/

# 코드 리뷰 임시/실패 산출물 (정식 리뷰 결과는 추적)
review/*.tmp.md

# scripts probe dump
scripts/_shipping_dump/
scripts/_tmp/

.vercel
.gstack/
