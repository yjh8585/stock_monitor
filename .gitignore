# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
# 이 프로젝트는 npm 전용(package-lock.json) — 글로벌 pnpm 설정이 만든 stray 파일 무시(format:check 깨짐 방지)
pnpm-lock.yaml
pnpm-workspace.yaml

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python
scripts/venv/
scripts/__pycache__/
scripts/**/__pycache__/
*.pyc

# 일회성 디버그/분석 산출물 (재발 방지)
scripts/docs_cache/
scripts/logs/
scripts/debug_*.png
docs_cache/

# 브라우저 자동화: Marklines 봇 산출물 (사용자 Chrome 프로파일은 OS 영역이라 별도 ignore 불필요)
scripts/_marklines_state.json
scripts/_debug_bosch_body.txt
scripts/_marklines_direct_log.json

# MCP 로컬 설정 (토큰 포함 — 커밋 금지)
.mcp.json

# env
.env.local
.env*.local

# Claude Code 로컬 상태 (사용자 권한 설정 / 스케줄 lock / 개인 hookify 규칙)
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/hookify.*.local.md

# 로그 / 임시 디렉토리
*.log
dev.log
tmp/
supabase/.temp/

# 사용자 참고 자료 (PDF/외부 문서)
참고/

# 코드 리뷰 임시/실패 산출물 (정식 리뷰 결과는 추적)
review/*.tmp.md

# scripts probe dump
scripts/_shipping_dump/
scripts/_tmp/
scripts/_yt_report/

.vercel
.gstack/

# ── 일회성 산출물 재발 방지 (2026-06-17 대량 정리 후) ──
# 루트 UI 검증 스크린샷 / 세션 리포트
/*.png
/session-report-*.html
# data 수집 산출물·캐시 (재생성 가능, 추적 안 함)
data/_*
data/report_*
# scripts 수집 실행 로그 / e2e 산출물 (정식 매핑 _marklines_/_top100_ 은 추적 유지)
scripts/_*_run_*.json
scripts/_e2e_smoke_report.json

# 일회성 스크립트·산출물 전반 (scripts/ 최상위의 _* 파일)
# 2026-08-06: 그동안 개별 파일만 나열돼 있어 사외비 본문이 담긴 변환 산출물이
# `git add .` 한 번에 저장소로 들어갈 수 있었다. 패턴으로 막는다.
# `_*` 는 슬래시를 넘지 않으므로 추적 대상인 scripts/_archive/ 하위에는 영향이 없다.
scripts/_*.py
scripts/_*.md
scripts/_*.mts
scripts/_*.ts
scripts/_*.json
scripts/_*.log
scripts/_*.txt
# 코드 리뷰 입력 임시물 (정식 결과 .md 는 추적)
review/*.diff
review/*-full.txt
review/*-prompt.md

# Playwright MCP 산출물
.playwright-mcp/

# Python 테스트 캐시
.pytest_cache/
