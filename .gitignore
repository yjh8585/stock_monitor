/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# MCP
mcp-shrimp-task-manager/node_modules/
.shrimp_data/

# Python
scripts/venv/
scripts/__pycache__/
scripts/**/__pycache__/
*.pyc

# 일회성 디버그/분석 산출물 (재발 방지)
scripts/docs_cache/
scripts/logs/
scripts/debug_*.png
docs_cache/

# MCP 로컬 설정 (토큰 포함 — 커밋 금지)
.mcp.json

# env
.env.local
.env*.local

# Claude Code 로컬 상태 (사용자 권한 설정 / 스케줄 lock)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# 로그 / 임시 디렉토리
*.log
dev.log
tmp/
supabase/.temp/

# 사용자 참고 자료 (PDF/외부 문서)
참고/
